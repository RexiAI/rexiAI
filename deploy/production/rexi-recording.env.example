# Secrets/config for the host-side recording processor, sourced by
# systemd-rexi-recording.service via EnvironmentFile. Install at
# /etc/rexi-recording.env (mode 0600). deploy-jitsi.sh seeds APP_BASE_URL,
# RECORDINGS_DIR, MEETING_BASE_URL; fill the rest.

# The deployed app (Vercel) — the processor POSTs /api/bookings/recorded-billing.
APP_BASE_URL=https://rexi-ai.com

# Where Jitsi rooms live (must match the app's MEETING_BASE_URL / jitsi PUBLIC_URL host).
MEETING_BASE_URL=https://meet.rexi-ai.com

# Host path to Jibri recordings (deploy-jitsi.sh sets this to the real dir).
RECORDINGS_DIR=/root/.jitsi-meet-cfg/storage/jibri/recordings

# Stripe LIVE secret key (reservations are looked up by join_url; never test in prod).
STRIPE_SECRET_KEY=sk_live_REPLACE_ME

# Shared bearer token for the recorded-billing endpoint (must equal the value set
# in the Vercel app's env). Generate: openssl rand -hex 32
RECORDED_BILLING_TOKEN=REPLACE_ME

# Processor behaviour (defaults shown; uncomment to change):
# Jibri session id is not the booking id, so the processor maps room→reservation.
# The recordings are kept in place + a .rexi-billed marker is written beside each
# billed MP4; set to 1 to also copy the recording into an archive tree.
#REXI_ARCHIVE_DIR=/opt/rexi-recordings/archive
