# Production .env for docker-jitsi-meet — RexiAI recording stack.
#
# Copy to ~/docker-jitsi-meet/.env on the VPS, then run ./gen-passwords.sh to
# fill the *Password vars, and set the placeholders below. deploy-jitsi.sh can
# do all of this for you.
#
# Placeholders to replace:
#   __DOMAIN__     the public hostname Jitsi is served on (A record → __PUBLIC_IP__)
#   __PUBLIC_IP__  the VPS public IPv4
#   __EMAIL__      admin email for Let's Encrypt notices
#   __TURN_HOST__  (optional) your coturn hostname; see README §TURN

# ── Basic ────────────────────────────────────────────────────────────────────
CONFIG=~/.jitsi-meet-cfg
# Port 80 is required for the Let's Encrypt HTTP-01 challenge; 443 serves HTTPS.
HTTP_PORT=80
HTTPS_PORT=443
TZ=Europe/Madrid

# The meeting URL clients AND Jibri load. Real domain, NOT localhost.
PUBLIC_URL=https://__DOMAIN__

# ── Media (JVB) — the part that breaks local installs ────────────────────────
# Advertise the PUBLIC IP so external clients and Jibri's Chrome both reach JVB.
# (Local WSL/Docker Desktop used 127.0.0.1,host.docker.internal — that does NOT
#  work for real clients; on a VPS this is the public IP.)
JVB_ADVERTISE_IPS=__PUBLIC_IP__

# ── TLS via Let's Encrypt (handled by the web container; no external proxy) ──
ENABLE_LETSENCRYPT=1
LETSENCRYPT_DOMAIN=__DOMAIN__
LETSENCRYPT_EMAIL=__EMAIL__
# Force HTTP→HTTPS.
ENABLE_HTTP_REDIRECT=1
# Test the cert flow without hitting prod rate limits, then flip to 0:
LETSENCRYPT_USE_STAGING=1

# ── Recording (Jibri) ────────────────────────────────────────────────────────
ENABLE_RECORDING=1
# RECORDINGS_DIR — independent recordings folder (the single knob). Jibri writes
# here via deploy/production/docker-compose.recordings.yml (mounted over
# /storage/recordings), so the videos can live anywhere — a separate volume, a
# backup-synced path — without moving the rest of the Jitsi config (CONFIG).
# Must equal the processor's RECORDINGS_DIR. deploy-jitsi.sh sets both.
# Unset → defaults to ${CONFIG}/storage/jibri/recordings.
#RECORDINGS_DIR=/home/you/rexi-recordings
# Jibri needs no /dev/snd — it uses a PulseAudio virtual sink (software audio).
# Point it at the recording organizer if you use the Jibri finalize-hook path
# instead of the systemd timer (see README §Trigger). The timer is the default.
#JIBRI_FINALIZE_RECORDING_SCRIPT_PATH=/opt/rexi-recording/finalize.sh

# ── Auto-record (mod_rexi_auto_record, spec 004) ─────────────────────────────
# Loads the repo's custom prosody module that starts a Jibri file recording
# automatically when the FIRST participant joins a room whose name starts with
# the prefix below. deploy-jitsi.sh copies the module into
# $CONFIG/prosody/prosody-plugins-custom/ and keeps BOTH module-hook lines
# (adding the module exactly once on hosts whose .env predates them):
#   GLOBAL_MODULES    → merges the module into the prosody VirtualHosts;
#   XMPP_MUC_MODULES  → loads it on the MUC component, where occupant-joined
#                       events fire — the module only works with this one set.
GLOBAL_MODULES=rexi_auto_record
XMPP_MUC_MODULES=rexi_auto_record
# REXI_AUTO_RECORD_PREFIX — room-name prefix that opts a room into
# auto-recording. Default: rexi- (every RexiAI booking room is rexi-<hex>).
# The module reads it from the PROSODY CONTAINER env; forward it via a compose
# override (see docs/local-e2e-testing.md §Auto-record install). Non-prefixed
# rooms are never auto-recorded — this is the consent boundary.
#REXI_AUTO_RECORD_PREFIX=rexi-

# ── Auth ─────────────────────────────────────────────────────────────────────
# Leave disabled: every booking is a random unguessable room (rexi-<hex>) that
# the join URL already authorises. Enabling ENABLE_AUTH would require XMPP users.
#ENABLE_AUTH=1
#ENABLE_GUESTS=1

# ── TURN (optional, for clients behind symmetric NAT) ────────────────────────
# Without TURN, a small share of restrictive-network clients can't connect.
# Run coturn (or the jitsi-coturn image) and uncomment:
#STUN_SERVER=__TURN_HOST__
#TURN_TRANSPORT=turn
#TURN_PORT=3478
#TURN_TLS_PORT=5349
#TC_URNE_HOST=__TURN_HOST__
#TURN_SHARED_SECRET=<long-random>

# ── Security / XMPP passwords ────────────────────────────────────────────────
# ./gen-passwords.sh fills these. DO NOT reuse across services.
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JIGASI_XMPP_PASSWORD=
JIGASI_TRANSCRIBER_PASSWORD=
JIBRI_RECORDER_PASSWORD=
JIBRI_XMPP_PASSWORD=
