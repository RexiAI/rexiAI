{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": "reports/mutation/stryker-incremental.json",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "api/**/*.ts",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.spec.ts",
    "!**/*.spec.tsx",
    "!**/*.d.ts",
    "!**/__tests__/**",
    "!src/i18n/locales/**",
    "!src/content/**"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "timeoutMS": 30000,
  "concurrency": 4,
  "ignorePatterns": [
    ".opencode",
    ".standards",
    ".agents",
    ".playwright-mcp",
    "dist",
    "reports",
    "specs",
    "docs",
    "okf"
  ]
}
