STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_TO=
# Calendar / Email provider selection (backward compat: unset → gmail/google)
# CALENDAR_PROVIDER — which calendar to create events in: google | microsoft (default google)
# EMAIL_PROVIDER — which mail path to use: gmail (Resend) | microsoft365 (Graph) (default gmail)
CALENDAR_PROVIDER=google
EMAIL_PROVIDER=gmail
# Microsoft 365 / Graph — required only when CALENDAR_PROVIDER=microsoft or EMAIL_PROVIDER=microsoft365
# How to obtain (Azure AD app, single-tenant):
# 1. https://portal.azure.com → Microsoft Entra ID → App registrations → New registration
#    - Name: RexiAI, Supported account types: Accounts in this organizational directory only
#    - Note Application (client) ID → MICROSOFT_CLIENT_ID, Directory (tenant) ID → MICROSOFT_TENANT_ID
# 2. Certificates & secrets → New client secret → copy Value → MICROSOFT_CLIENT_SECRET
# 3. API permissions → Add a permission → Microsoft Graph → Application permissions:
#    OnlineMeetings.ReadWrite, Calendars.ReadWrite, Mail.Send → Grant admin consent
# 4. MICROSOFT_USER_ID — UPN or object ID of the mailbox that owns the calendar (e.g. daniel@rexi-ai.com)
#    The app acts as this user via /users/{MICROSOFT_USER_ID}/...
# 5. Teams recording guarantee (owner can enable): Teams admin center or PowerShell:
#    Set-CsTeamsMeetingPolicy -Identity Global -AllowCloudRecording $true -RecordingStorageMode OneDriveForBusiness
#    Code sets allowRecording true; policy must allow it for recording to actually work.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_USER_ID=
# Availability — env overrides for timezone and working hours (Vercel env vars).
# When any of these is set, they override config/availability.yaml (which remains as fallback).
# AVAILABILITY_TIMEZONE — IANA timezone, default Europe/Madrid. Example: Europe/Madrid, America/New_York
AVAILABILITY_TIMEZONE=Europe/Madrid
# AVAILABILITY_HOURS — daily working windows, default "09:00-13:00". Format: "HH:MM-HH:MM[,HH:MM-HH:MM]*" e.g. "09:00-13:00,14:00-18:00"
AVAILABILITY_HOURS=09:00-13:00
# AVAILABILITY_DAYS — comma-separated weekdays, default "monday,tuesday,wednesday,thursday,friday". Values: monday..sunday case-insensitive.
AVAILABILITY_DAYS=monday,tuesday,wednesday,thursday,friday
# Billing — pro-rata per minute at €30/h = €0.50/min (50 cents/min). Free 60 min once per email (Stripe customer metadata rexi_free_hour_used).
# Reservation is prepaid for booked hours; post-meeting correction via POST /api/bookings/recorded-billing { bookingId, email, actualMinutes }
# RECORDED_BILLING_TOKEN — bearer token protecting POST /api/bookings/recorded-billing.
# Generate with: openssl rand -hex 32 — then set it in Vercel (Project Settings → Environment Variables).
# Unset → the endpoint returns 503 NOT_CONFIGURED (fails closed, never open).
RECORDED_BILLING_TOKEN=
# Recorded billing is additionally bounded by the reservation itself: the
# submitted actualMinutes may not exceed the booked quoted_hours plus a
# 15-minute overrun grace (409 MINUTES_EXCEED_BOOKING), and an unresolvable
# bookingId is refused outright (404 BOOKING_NOT_FOUND).
#
# Rate limiting — POST /api/bookings only. In-memory sliding window, per lambda
# instance, keyed on the first x-forwarded-for hop. This is BEST-EFFORT: Vercel
# gives every cold start and every concurrent invocation a fresh process, so the
# budget below is per-instance, not global, and the header is client-spoofable.
# A hard global bound needs a shared store (Upstash/Redis) or an edge WAF rule.
# BOOKING_RATE_LIMIT — requests allowed per IP per window. Default 10.
BOOKING_RATE_LIMIT=10
# BOOKING_RATE_WINDOW_MIN — window length in minutes. Default 10.
BOOKING_RATE_WINDOW_MIN=10
# Client confirmation email — sent to the booking address after the operator
# mail succeeds. REQUIRES A VERIFIED SENDING DOMAIN: with the Resend sandbox
# sender (EMAIL_FROM=onboarding@resend.dev) Resend only delivers to the account
# owner, so every real client address is rejected. Verify a domain in Resend and
# point EMAIL_FROM at it (e.g. hola@rexi-ai.com) before relying on this. The
# failure is logged distinctly and never fails the Stripe webhook.
